# bash completion for claude (subcommands + flags). Flags are delegated to
# bash-completion's own generic `_comp_complete_longopt`, which parses
# `claude --help` live at completion time -- no hand-scraped list, never
# goes stale. Only handles long (--xxx) options, not the short forms
# (-c -d -h -n -p -r -v -w); subcommand names are hand-listed since claude
# ships no `completion` generator and this repo has no other source for them.

_claude() {
    local cur prev words cword
    _init_completion || return

    local subcommands="agents auth auto-mode doctor gateway install mcp plugin plugins project setup-token ultrareview update upgrade"

    if [[ $cur == -* ]]; then
        _comp_complete_longopt claude
        return
    fi

    # only offer subcommands as the first non-option arg; otherwise fall
    # back to file completion (claude takes free-text prompts/paths)
    local i sub=""
    for ((i = 1; i < cword; i++)); do
        case "${words[i]}" in
            -*) ;;
            *) sub="${words[i]}"; break ;;
        esac
    done

    if [[ -z $sub ]]; then
        COMPREPLY=($(compgen -W "$subcommands" -- "$cur"))
        compopt -o default 2>/dev/null
        return
    fi

    _filedir
}
complete -F _claude claude
